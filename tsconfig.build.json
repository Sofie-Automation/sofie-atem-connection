{
	"extends": "@sofie-automation/code-standard-preset/ts/tsconfig.lib",
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules/**", "src/**/*spec.ts", "src/**/__tests__/*", "src/**/__mocks__/*", "scratch/**"],
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"skipLibCheck": true,
		"types": ["node"],
		"composite": true,
		"importHelpers": false // we don't need tslib, but just in case
	}
}
